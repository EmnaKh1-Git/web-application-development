# Modèle de configuration du Front-End (copié en .env par « npm run setup:env »).
# Seules les variables préfixées par VITE_ sont visibles dans le navigateur :
# n'y mettez JAMAIS de secret (clé d'API, mot de passe...).

# URL de l'API Back-End
VITE_API_URL=http://localhost:4000/api/v1

# Configuration publique Supabase (jamais de clé secrète côté frontend)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
