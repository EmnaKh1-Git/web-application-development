# ─────────────────────────────────────────────────────────────
# Variables des tests du cours (Jest, Cucumber, Postman/k6, Playwright).
# Valeurs FICTIVES uniquement : aucun mot de passe, aucune clé API réelle. Versionné dans Git.
# Chargé par backend/tests/setup/test-env.js ; une variable déjà définie (CI) reste prioritaire.
# ─────────────────────────────────────────────────────────────

NODE_ENV=test

# Base de test séparée, jamais la base de développement (elle est vidée par les tests).
DB_NAME=smart_ecommerce
DB_NAME_TEST=smart_ecommerce_test

# Connexion MySQL. Tests unitaires : la base est simulée (mock), aucune connexion n'est ouverte ;
# l'utilisateur est volontairement fictif, un test qui tenterait de joindre MySQL échouerait.
# Tests avec la vraie base de test : DB_HOST, DB_PORT, DB_USER et DB_PASSWORD viennent de
# backend/.env (ou des variables de la CI), jamais de ce fichier.
DB_HOST=localhost
DB_PORT=3306
DB_USER=utilisateur_fictif_tests
DB_PASSWORD=

# Secret réservé aux tests automatisés (ce n'est pas un secret réel).
JWT_SECRET=jwt-fictif-reserve-aux-tests-jest-0123456789
BCRYPT_SALT_ROUNDS=4

# IA : toujours locale pendant les tests, jamais de clé.
AI_PROVIDER=local
ANTHROPIC_API_KEY=

# Seules les erreurs sont affichées pendant les tests.
LOG_LEVEL=error
