# ─────────────────────────────────────────────────────────────
# Modèle de configuration du Back-End.
# Copier en « .env » avec : npm run setup:env (à la racine du projet),
# qui génère aussi des secrets aléatoires. Le fichier .env n'est JAMAIS versionné.
# ─────────────────────────────────────────────────────────────

# ─── Serveur ───
NODE_ENV=development
# Port de l'API (nom propre au projet : une variable PORT fixée par un autre outil ne le change pas)
API_PORT=4000
# Origines autorisées par CORS (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173

# ─── Base de données MySQL ───
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_ecommerce
# Base dédiée aux tests automatisés (vidée à chaque test)
DB_NAME_TEST=smart_ecommerce_test
DB_USER=smart_user
DB_PASSWORD=
# Compte administrateur MySQL, utilisé uniquement par Docker (création du conteneur)
# et par « npm run db:create ». Avec WAMP/XAMPP : root et mot de passe VIDE par défaut.
DB_ROOT_USER=root
DB_ROOT_PASSWORD=
# Afficher les requêtes SQL dans la console (true/false)
DB_LOGGING=false

# ─── Sécurité ───
# Au moins 32 caractères aléatoires (générés par npm run setup:env)
JWT_SECRET=
# Durée de validité du jeton : 15m, 1h, 7d...
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=12

# ─── Limitation du nombre de requêtes par IP ───
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=20

# ─── Logs : error | warn | info | debug ───
LOG_LEVEL=info

# ─── Intelligence Artificielle ───
# Sans clé, l'IA fonctionne avec les algorithmes locaux (prévisions, recommandations, analyses).
# Avec une clé Anthropic (https://console.anthropic.com), Claude ajoute la lecture des photos,
# l'assistant conversationnel et la rédaction de textes. Ne jamais versionner la clé.
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=30000
AI_RATE_LIMIT_MAX=60

# ─── Supabase ───
# La clé secrète reste uniquement dans backend/.env et ne doit jamais être exposée au frontend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# ─── Comptes de démonstration créés par « npm run db:seed » ───
SEED_ADMIN_EMAIL=admin@smart-ecommerce.test
SEED_ADMIN_PASSWORD=
SEED_STOCK_MANAGER_EMAIL=stock@smart-ecommerce.test
SEED_STOCK_MANAGER_PASSWORD=
SEED_CLIENT_EMAIL=client@smart-ecommerce.test
SEED_CLIENT_PASSWORD=
